# Copy to .env (gitignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Key from an AI Studio project on the paid tier (Google AI Pro credits applied)
GEMINI_API_KEY=
# Judge provider: set one of these, and JUDGE_PROVIDER to "deepinfra" or "openrouter"
JUDGE_PROVIDER=deepinfra
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY is also used for search: it embeds queries with Qwen3-Embedding-8B
