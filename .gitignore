# Benchmark data: decrypted questions, answers, documents, published runs, caches.
# BrowseComp-Plus asks that this never appear as plain text online.
data/

# Secrets
.env
.env.*
!.env.example

# Raw traces and judgments are committed only in encrypted form (`python -m src.runner pack`):
# <file>.jsonl.gz.enc, gzip + the BrowseComp-Plus canary XOR. Debug traces stay local.
results/**/*.jsonl
results/debug/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
